<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework Condition="'$(HostTfm)' == ''">net11.0-android</TargetFramework>
    <TargetFramework Condition="'$(HostTfm)' != ''">$(HostTfm)</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <ApplicationId>io.ref12.indexnode.spike</ApplicationId>
    <ApplicationDisplayVersion>0.0.1</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <SupportedOSPlatformVersion>26.0</SupportedOSPlatformVersion>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <RuntimeIdentifiers>android-arm64</RuntimeIdentifiers>
    <RuntimeIdentifier>android-arm64</RuntimeIdentifier>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Keep all of CoreLib: plugins call BCL APIs the host never uses (costs ~3 MB, see README). -->
    <RootCoreLib Condition="'$(RootCoreLib)' == ''">true</RootCoreLib>
  </PropertyGroup>

  <!-- Release: the normal settings (trim + AOT), plus what hot-loading needs -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
    <!-- Plugins call BCL APIs the host never uses; JIT is the fallback for the (non-AOT) plugin DLL.
         UseInterpreter is NOT needed on Android (JIT is allowed); set true to force interpretation of non-AOT code. -->
    <UseInterpreter>false</UseInterpreter>
    <!-- Plugins use System.Text.Json reflection serialization; trimmed apps switch it off by default. -->
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
    <DebugSymbols>false</DebugSymbols>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <!-- .NET 11 for Android defaults to CoreCLR (JIT + ReadyToRun; Mono-style AOT is rejected: XA1044).
       Variant: -p:HostTfm=net10.0-android (SDK 10, see global.net10.json) is Mono with full AOT (JIT fallback stays for plugin DLLs). -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release' and '$(HostTfm)' == 'net10.0-android'">
    <RunAOTCompilation>true</RunAOTCompilation>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release' and '$(HostTfm)' != 'net10.0-android'">
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Contract/Contract.csproj" />
    <ProjectReference Include="../Loader/Loader.csproj" />
    <PackageReference Include="Xamarin.AndroidX.WebKit" Version="1.14.0.1" />
  </ItemGroup>

  <ItemGroup>
    <TrimmerRootDescriptor Include="ILLink.Descriptors.xml" />
    <TrimmerRootAssembly Include="System.Private.CoreLib" RootMode="All" Condition="'$(RootCoreLib)' == 'true'" />
  </ItemGroup>

  <!-- Keep the contract whole and the BCL surface plugins are likely to use (the host itself only uses a slice). -->
  <ItemGroup>
    <TrimmerRootAssembly Include="Spike.Contract" RootMode="All" />
    <TrimmerRootAssembly Include="Spike.Loader" RootMode="All" />
    <TrimmerRootAssembly Include="Host" RootMode="All" />
    <TrimmerRootAssembly Include="System.Linq" RootMode="All" />
    <TrimmerRootAssembly Include="System.Collections" RootMode="All" />
    <TrimmerRootAssembly Include="System.Text.Json" RootMode="All" />
    <TrimmerRootAssembly Include="System.Text.RegularExpressions" RootMode="All" />
    <TrimmerRootAssembly Include="System.Net.Http" RootMode="All" />
    <TrimmerRootAssembly Include="System.Runtime" RootMode="All" />
  </ItemGroup>
</Project>
