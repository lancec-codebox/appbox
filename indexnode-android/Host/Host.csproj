<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>IndexNode.Host</AssemblyName>
    <RootNamespace>IndexNode.Host</RootNamespace>
    <ApplicationId>io.ref12.indexnode</ApplicationId>
    <!-- Host version: CI publishes a release indexnode-android-v&lt;version&gt; when this is new. ApplicationVersion must grow with it. -->
    <ApplicationDisplayVersion>0.1.4</ApplicationDisplayVersion>
    <ApplicationVersion>5</ApplicationVersion>
    <SupportedOSPlatformVersion>26.0</SupportedOSPlatformVersion>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <RuntimeIdentifiers>android-arm64</RuntimeIdentifiers>
    <RuntimeIdentifier>android-arm64</RuntimeIdentifier>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- The owner's choice: CoreCLR (.NET 11 default), untrimmed, so a plugin may call any .NET API. ReadyToRun keeps the start fast. -->
    <PublishTrimmed>false</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <PublishReadyToRun>true</PublishReadyToRun>
    <DebugSymbols>false</DebugSymbols>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Contract/Contract.csproj" />
    <ProjectReference Include="../Loader/Loader.csproj" />
    <ProjectReference Include="../Medusa/Medusa.csproj" />
    <ProjectReference Include="../Plugin/Plugin.csproj" ReferenceOutputAssembly="false" />
    <PackageReference Include="Xamarin.AndroidX.WebKit" Version="1.14.0.1" />
    <PackageReference Include="Xamarin.AndroidX.Work.Runtime" Version="2.10.0.1" />
  </ItemGroup>

  <!-- The bundled plugin (the last-resort fallback): the Plugin project's DLL and a manifest made from its hash go into the APK's assets. -->
  <Target Name="BundlePlugin" BeforeTargets="BeforeBuild;_GenerateAndroidAssetsDir">
    <MSBuild Projects="../Plugin/Plugin.csproj" Properties="Configuration=$(Configuration)" Targets="Build" />
    <PropertyGroup>
      <_PluginDll>$(MSBuildThisFileDirectory)../Plugin/bin/$(Configuration)/net11.0/IndexNode.Plugin.dll</_PluginDll>
      <_BundleDir>$(MSBuildThisFileDirectory)obj/bundled/</_BundleDir>
    </PropertyGroup>
    <MakeDir Directories="$(_BundleDir)" />
    <Copy SourceFiles="$(_PluginDll)" DestinationFolder="$(_BundleDir)" />
    <GetFileHash Files="$(_PluginDll)" Algorithm="SHA256" HashEncoding="hex">
      <Output TaskParameter="Items" ItemName="_PluginHash" />
    </GetFileHash>
    <GetAssemblyIdentity AssemblyFiles="$(_PluginDll)">
      <Output TaskParameter="Assemblies" ItemName="_PluginId" />
    </GetAssemblyIdentity>
    <PropertyGroup>
      <_PluginSha>%(_PluginHash.FileHash)</_PluginSha>
      <_PluginVer>$([System.Text.RegularExpressions.Regex]::Replace('%(_PluginId.Version)', '\.0$', ''))</_PluginVer>
    </PropertyGroup>
    <WriteLinesToFile File="$(_BundleDir)manifest.json" Lines="{&quot;version&quot;:&quot;$(_PluginVer)&quot;,&quot;sha256&quot;:&quot;$(_PluginSha.ToLowerInvariant())&quot;,&quot;dll&quot;:&quot;IndexNode.Plugin.dll&quot;}" Overwrite="true" />
    <ItemGroup>
      <AndroidAsset Include="$(_BundleDir)IndexNode.Plugin.dll" Link="plugin/IndexNode.Plugin.dll" />
      <AndroidAsset Include="$(_BundleDir)manifest.json" Link="plugin/manifest.json" />
    </ItemGroup>
  </Target>

  <!-- tracing 1.3 folded tracing-ktx into tracing-android; WorkManager still brings the old ktx binding, which defines the same classes (R8: "defined multiple times") -->
  <Target Name="DropDuplicateTracingKtx" BeforeTargets="_ResolveLibraryProjectImports;_ResolveAars">
    <ItemGroup>
      <AndroidAarLibrary Remove="@(AndroidAarLibrary)" Condition="$([System.String]::Copy('%(Filename)').Contains('tracing-ktx'))" />
      <AndroidLibrary Remove="@(AndroidLibrary)" Condition="$([System.String]::Copy('%(Filename)').Contains('tracing-ktx'))" />
    </ItemGroup>
  </Target>
</Project>
