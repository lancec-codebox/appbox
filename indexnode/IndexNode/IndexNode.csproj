<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>indexnode</AssemblyName>
    <RootNamespace>IndexNode</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <Version>0.2.0</Version>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>indexnode</ToolCommandName>
    <PackageId>IndexNode</PackageId>
    <Description>Desktop node of the drama index: downloads, frames, SSCD descriptors and AV1 compression over a shared blob container.</Description>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ValidateExecutableReferencesMatchSelfContained>false</ValidateExecutableReferencesMatchSelfContained>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Storage.Blobs" Version="12.24.0" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.23.2" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="IndexNode.Tests" />
    <None Include="PROTOCOL.md" />
    <None Include="tools/**" />
  </ItemGroup>

</Project>
