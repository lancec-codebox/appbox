<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>indexnode</AssemblyName>
    <RootNamespace>IndexNode</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <Version>0.5.5</Version>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>indexnode</ToolCommandName>
    <PackageId>IndexNode</PackageId>
    <Description>Desktop node of the drama index: downloads, frames, SSCD descriptors and AV1 compression over a shared blob container.</Description>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ValidateExecutableReferencesMatchSelfContained>false</ValidateExecutableReferencesMatchSelfContained>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Storage.Blobs" Version="12.24.0" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime.Managed" Version="1.23.2" />
    <PackageReference Include="Microsoft.ML.Tokenizers" Version="3.0.0" />
    <PackageReference Include="org.k2fsa.sherpa.onnx" Version="2.0.1" />
    <PackageReference Include="QRCoder" Version="1.6.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="IndexNode.Tests" />
    <None Include="PROTOCOL.md" />
    <None Include="tools/**" />
    <EmbeddedResource Include="Resources/TSCharacters.txt" LogicalName="opencc.TSCharacters.txt" />
    <EmbeddedResource Include="Resources/TSPhrases.txt" LogicalName="opencc.TSPhrases.txt" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Ocr\zh-words.txt.gz" LogicalName="zh-words.txt.gz" />
  </ItemGroup>
</Project>
