<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>indexnode</AssemblyName>
    <RootNamespace>IndexNode</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <Version>0.13.88</Version>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>indexnode</ToolCommandName>
    <PackageId>IndexNode</PackageId>
    <Description>Desktop node of the drama index: downloads, frames, SSCD descriptors and AV1 compression over a shared blob container.</Description>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ValidateExecutableReferencesMatchSelfContained>false</ValidateExecutableReferencesMatchSelfContained>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../IndexNode.Core/IndexNode.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Storage.Blobs" Version="12.24.0" />
    <PackageReference Include="BitMiracle.LibJpeg.NET" Version="1.5.324" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime.Managed" Version="1.23.2" />
    <PackageReference Include="Microsoft.ML.Tokenizers" Version="3.0.0" />
    <PackageReference Include="org.k2fsa.sherpa.onnx" Version="2.0.1" />
    <PackageReference Include="QRCoder" Version="1.6.0" />
  </ItemGroup>

  <!-- GPU build: dotnet publish -p:IndexNodeGpu=true -r linux-x64 (CUDA 12 + cuDNN 9 libraries come from the container).
       0.13.86: Microsoft's onnxruntime 1.23.2 GPU for everything, and sherpa-onnx 2.0.1's C API rebuilt against it (appbox release
       tools-sherpa-onnx-2.0.1-msort-1.23.2, built by tools/build-sherpa-msort.sh; sherpa's own prebuilt c-api needs VERS_1.28.2). 0.13.83-0.13.85 shipped
       sherpa's CUDA package with its onnxruntime 1.28.2 instead, which made transcribe work on the card but the OCR reader ~3x slower (T4, 2026-11-27).
       The sherpa runtime package's CPU libonnxruntime.so and c/cxx api are replaced; the rebuilt ones are downloaded once per obj folder, sha256-checked. -->
  <ItemGroup Condition="'$(IndexNodeGpu)' == 'true'">
    <PackageReference Include="Microsoft.ML.OnnxRuntime.Gpu.Linux" Version="1.23.2" />
  </ItemGroup>
  <PropertyGroup Condition="'$(IndexNodeGpu)' == 'true'">
    <SherpaMsortUrl>https://github.com/lancec-codebox/appbox/releases/download/tools-sherpa-onnx-2.0.1-msort-1.23.2-glibc2.34/</SherpaMsortUrl>
    <SherpaMsortDir>$(MSBuildProjectDirectory)/obj/sherpa-msort-g234/</SherpaMsortDir>
    <SherpaCApiSha256>AA6FED6D316D883B6B99032AA0D2CF21E3C39D7E9C4F80DAF0CCBD33605971C4</SherpaCApiSha256>
    <SherpaCxxApiSha256>4BAC0DA160CE758F4069C5C412C54DD6030C69F94134944A0DD9E35C32FEE524</SherpaCxxApiSha256>
  </PropertyGroup>
  <Target Name="IndexNodeGpuNatives" AfterTargets="ResolvePackageAssets" Condition="'$(IndexNodeGpu)' == 'true'">
    <DownloadFile SourceUrl="$(SherpaMsortUrl)libsherpa-onnx-c-api.so" DestinationFolder="$(SherpaMsortDir)" Condition="!Exists('$(SherpaMsortDir)libsherpa-onnx-c-api.so')" />
    <DownloadFile SourceUrl="$(SherpaMsortUrl)libsherpa-onnx-cxx-api.so" DestinationFolder="$(SherpaMsortDir)" Condition="!Exists('$(SherpaMsortDir)libsherpa-onnx-cxx-api.so')" />
    <GetFileHash Files="$(SherpaMsortDir)libsherpa-onnx-c-api.so" Algorithm="SHA256"><Output TaskParameter="Hash" PropertyName="_CApiHash" /></GetFileHash>
    <GetFileHash Files="$(SherpaMsortDir)libsherpa-onnx-cxx-api.so" Algorithm="SHA256"><Output TaskParameter="Hash" PropertyName="_CxxApiHash" /></GetFileHash>
    <Error Condition="'$(_CApiHash)' != '$(SherpaCApiSha256)' or '$(_CxxApiHash)' != '$(SherpaCxxApiSha256)'" Text="rebuilt sherpa-onnx libraries: sha256 mismatch (c-api $(_CApiHash), cxx-api $(_CxxApiHash))" />
    <ItemGroup>
      <NativeCopyLocalItems Remove="@(NativeCopyLocalItems)" Condition="'%(NuGetPackageId)' == 'org.k2fsa.sherpa.onnx.runtime.linux-x64' and ('%(Filename)%(Extension)' == 'libonnxruntime.so' or '%(Filename)%(Extension)' == 'libsherpa-onnx-c-api.so' or '%(Filename)%(Extension)' == 'libsherpa-onnx-cxx-api.so')" />
      <_SherpaMsortLibs Include="$(SherpaMsortDir)libsherpa-onnx-c-api.so;$(SherpaMsortDir)libsherpa-onnx-cxx-api.so" />
      <NativeCopyLocalItems Include="@(_SherpaMsortLibs)" AssetType="native" DestinationSubPath="%(Filename)%(Extension)" NuGetPackageId="sherpa-onnx-msort" NuGetPackageVersion="2.0.1" CopyLocal="true" />
    </ItemGroup>
    <Message Importance="high" Text="IndexNode GPU build: Microsoft onnxruntime 1.23.2 GPU + sherpa-onnx 2.0.1 rebuilt against it" />
  </Target>

  <ItemGroup>
    <InternalsVisibleTo Include="IndexNode.Tests" />
    <None Include="PROTOCOL.md" />
    <None Include="tools/**" />
    <EmbeddedResource Include="Prompts/*.yaml" LogicalName="prompts/%(Filename)%(Extension)" />
    <EmbeddedResource Include="Resources/ai-frames-v3.f32" LogicalName="ai-frames-v3.f32" />
    <EmbeddedResource Include="Resources/TSCharacters.txt" LogicalName="opencc.TSCharacters.txt" />
    <EmbeddedResource Include="Resources/TSPhrases.txt" LogicalName="opencc.TSPhrases.txt" />
  </ItemGroup>

  <ItemGroup>
  </ItemGroup>
</Project>
